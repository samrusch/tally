# Copy this file to .env and fill in the two values.
# Find them in the Supabase dashboard: Project Settings -> API
#   - Project URL
#   - Publishable key (older projects call it the "anon" key)
# Never put the secret / service_role key here; this app does not need it.

NUXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=your-publishable-key
